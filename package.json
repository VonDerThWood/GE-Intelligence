{
  "name": "genius-ge-intelligence",
  "productName": "GEnius",
  "version": "2.7.0",
  "description": "RuneScape 3 Grand Exchange Market Intelligence",
  "main": "src/main.js",
  "author": "VonDerThWood",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "prebuild": "node scripts/sync-overrides.js",
    "build": "electron-builder --win --x64",
    "build:dir": "electron-builder --win --x64 --dir",
    "postinstall": "electron-builder install-app-deps && node scripts/patch-capacitor.js",
    "test-mode": "electron . --test-mode --remote-debugging-port=9333"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "path-browserify": "^1.0.1",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "com.vonderthwood.genius",
    "productName": "GEnius",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "!node_modules/@capacitor/**",
      "!node_modules/tslib/**"
    ],
    "asarUnpack": [
      "src/backend-js/data/**/*"
    ],
    "extraResources": [
      {
        "from": "assets/",
        "to": "assets/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GEnius",
      "allowElevation": true,
      "include": "build/installer.nsh"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/background-runner": "^3.0.0",
    "@capacitor/core": "^8.4.1",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/preferences": "^8.0.1"
  }
}
